# Vite 8 通过 Rolldown 分发平台相关的原生二进制，它们挂在 optionalDependencies 下。
# 若构建环境默认 --omit=optional，Linux 绑定的 .node 文件就不会被安装，
# 构建会以「Cannot find native binding」失败。
#
# 注意用的是 include[]= 数组元素语法；写成 include=optional=true 会被解析成
# 单个字符串 ["optional=true"]，等于没配。
include[]=prod
include[]=dev
include[]=optional
include[]=peer

# 构建日志更干净，也少一次网络往返
audit=false
fund=false
