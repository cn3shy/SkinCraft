# 复制为 .env.local 后填入真实值（.env.local 已被 gitignore）。
# 线上的这些变量配置在 EdgeOne Pages 控制台，不在仓库里。

# 管理员上传密码。请用 40+ 位随机字符串，不要用示例值。
ADMIN_PASSWORD=

# fine-grained PAT：仅限本仓库，权限只勾 Contents: Read and write。
# 绝不要提交，也绝不要下发给浏览器。
GITHUB_TOKEN=

# 形如 owner/repo
GITHUB_REPO=

# 生产分支
GITHUB_BRANCH=main

# 用于拼绝对直链，例如 https://skins.3shy.cn
SITE_ORIGIN=

# 单批上传上限
MAX_BATCH=30
